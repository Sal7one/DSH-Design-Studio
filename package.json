{
  "name": "@sal7one/dsh-design-studio",
  "version": "2.4.4",
  "description": "Persistent Design Studio plugin for DeepSeek Harness: the design_studio agent tool, a /design-studio live-preview route + JSON API, identity presets, an attributed 88-style design atlas, content-addressed edit history with undo/restore, OpenRouter vision review, a real harness-subagent design agent, and a vision-first Settings page — plus the built-in Design Studio conversation tab. Zero runtime dependencies (plain JS, no install-time build step).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "locale/*.json",
    "icon.svg"
  ],
  "license": "MIT",
  "author": "Sal7one",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sal7one/DSH-Design-Studio.git"
  },
  "homepage": "https://github.com/Sal7one/DSH-Design-Studio#readme",
  "bugs": {
    "url": "https://github.com/Sal7one/DSH-Design-Studio/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "design-studio",
    "design-system",
    "style-atlas",
    "design-gallery",
    "design-tokens",
    "ui-mockup",
    "openrouter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "build:client": "node scripts/bundle-client.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/host.test.mjs tests/client.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
