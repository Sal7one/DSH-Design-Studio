{
  "id": "sal7one-dark",
  "name": "Sal7one Dark",
  "version": 1,
  "colors": {
    "bg": "#0b0e14",
    "panel": "#141a26",
    "panel2": "#1a2233",
    "border": "#24304a",
    "text": "#e6ebf5",
    "muted": "#8894ab",
    "accent": "#a78bfa",
    "ok": "#4ade80",
    "warn": "#fbbf24",
    "err": "#f87171",
    "info": "#60a5fa"
  },
  "logos": {
    "mark": "assets/logos/sal7one-mark.svg",
    "wordmark": "assets/logos/sal7one-wordmark.svg",
    "favicon": "assets/logos/favicon.png"
  },
  "fonts": {
    "body": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "display": "system-ui, -apple-system, sans-serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, monospace"
  },
  "radius": "12px",
  "spacing": 16,
  "components": {
    "card": "background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius);",
    "button": "background: var(--accent); color: #0b0e14; border: 0; border-radius: 8px;"
  }
}
